# ==============================================================================
# MaintAI Production Environment Configuration (.env.production)
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# ------------------------------------------------------------------------------
# Supabase Configuration (Required for Production Database)
# ------------------------------------------------------------------------------
# Project URL from Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co

# Public Anon Key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Secret Service Role Key (Keep secure! Server-side only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# AI Provider Configuration
# ------------------------------------------------------------------------------
# Selected provider: groq | gemini | openai
AI_PROVIDER=groq

# Groq (High-speed inference - Llama 3.3 70B)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (Recommended for Vision AI machine detection)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (Optional alternative for chat and vision)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
