# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# AI Provider Configuration (Optional - for AI features)
# Choose one: openai, gemini, or groq
# This controls the chat/text AI (FixBot)
AI_PROVIDER=groq

# Groq Configuration (Recommended for Chat - Fast & Free)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini Configuration (Recommended for Vision - Free tier supports image analysis)
# Vision (camera detection) will use Gemini if available, otherwise OpenAI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Alternative: OpenAI (Optional - Paid, supports both chat and vision)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o
